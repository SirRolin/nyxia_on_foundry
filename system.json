{
  "id": "nyxia_classless",
  "title": "Nyxia Classless",
  "description": "Custom system builder to build character sheets and rulesets for any game.",
  "version": "0.1.1.1",
  "compatibility": {
    "minimum": "10",
    "verified": "11"
  },
  "template.version": 1,
  "authors": [{
      "name": "Sir Rolin"
    }],
  "esmodules": [
    "module/sandbox.js"
  ],
  "styles": [
    "styles/sandbox.css",
    "styles/dropdownmenu.css",
    "styles/sb-codemirror.css",
    "styles/system-settings.css",
    "styles/sandbox-icons-font.css"
  ],
  "relationships": {    
    "requires": [{
      "id": "_CodeMirror",
      "type": "module",
      "manifest": "https://raw.githubusercontent.com/League-of-Foundry-Developers/codemirror-lib/master/module.json",
      "compatibility": {
        "verified": "5.58.3-fvtt5"
      }
    }]
  },
  "packs": [],
  "socket": true,  
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "grid.distance": 1,
  "grid.units": "m",
  "primaryTokenAttribute": "health",
  "secondaryTokenAttribute": "spell_power",
  "url":       "https://github.com/SirRolin/nyxia_on_foundry",
  "manifest":  "https://github.com/SirRolin/nyxia_on_foundry/system.json",
  "download":  "https://github.com/SirRolin/nyxia_on_foundry/build.zip"
}
